PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key

# Optional alternative auth (preferred by Pinata):
# PINATA_JWT=your_pinata_jwt

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-vercel-domain.vercel.app
# Optional: override allowed browser origins regex.
# Example (localhost + all vercel.app previews):
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$|^https://[A-Za-z0-9-]+\.vercel\.app$